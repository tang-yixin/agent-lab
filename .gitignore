# ---- Python ----
# 虚拟环境（本地运行时，不入库）
.venv/
venv/
__pycache__/
*.pyc
*.pyo

# ---- 密钥（绝不入库，避免泄露 API key）----
config/secrets.env

# ---- 构建产物 ----
# Maven 编译产物（jar 由 mvn package 生成）
src/hadoop/target/

# ---- 运行产物（每次任务自动归档的报告，不入库）----
reports/

# ---- IDE / 系统 ----
.idea/
*.iml
.DS_Store
Thumbs.db
*.log
